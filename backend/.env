# Database Configuration
# DATABASE_URL=postgresql://disease_user:disease_password@postgres:5432/disease_prediction
# POSTGRES_HOST=postgres
DATABASE_URL=postgresql://disease_user:disease_password@localhost:5432/disease_prediction
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=disease_user
POSTGRES_PASSWORD=disease_password
POSTGRES_DB=disease_prediction

# Application Configuration
APP_NAME=Disease Prediction API
APP_VERSION=1.0.0
DEBUG=False
API_V1_PREFIX=/api/v1

# ML Model Paths (relative to app directory in container)
MODEL_PATH=ml/models/random_forest_model.pkl
LABEL_ENCODER_PATH=ml/models/label_encoder.pkl
FEATURE_NAMES_PATH=ml/models/feature_names.pkl

# CORS Configuration
CORS_ORIGINS=["http://localhost:4200","http://frontend:80"]

# Logging
LOG_LEVEL=INFO

